{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fsr-scrim-bot",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "workers_dev": true,
  "d1_databases": [{
    "binding": "DB", "database_name": "fsr-scrim",
    "database_id": "95a4e595-8964-417b-9b82-00e416d20d7b",
    "migrations_dir": "migrations"
  }],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "WORKER_URL": "https://fsr-scrim-bot.cjswo316.workers.dev",
    "APPLICATION_ID": "1549399405088612462",
    "DISCORD_PUBLIC_KEY": "b28e73f71367601f76ee013a011f111334524426bfaf27a0acc28c707128cf60",
    "ADMIN_ROLE_ID": "1559462141956718702, 1547226502368722944, 1545778178621055036",
    "WAITING_CHANNEL_NAME": "대기실",
    "TEAM_CHANNEL_TEMPLATE": "팀 {number}",
    "BIG_CHANNEL_NAME": "빅", "MAKER_CHANNEL_NAME": "메이커", "SCORER_CHANNEL_NAME": "스코어러",
    "ENDED_PANEL_DELETE_MINUTES": "60"
  }
}
