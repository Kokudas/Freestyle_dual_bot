{
  "name": "fsr-scrim-workers",
  "version": "2.1.0",
  "private": true,
  "engines": { "node": ">=22.0.0" },
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "check": "node --check src/worker.js && node --check src/domain.js && node --check src/ui.js && node --check src/storage.js && node --check src/discord.js",
    "register": "node --env-file-if-exists=.dev.vars scripts/register-commands.mjs",
    "db:local": "wrangler d1 migrations apply fsr-scrim --local",
    "db:remote": "wrangler d1 migrations apply fsr-scrim --remote"
  },
  "devDependencies": { "wrangler": "4.151.0", "miniflare": "5.20261012.0-beta" }
}
